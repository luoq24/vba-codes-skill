# Git 忽略文件配置

# Excel 文件（二进制文件，不纳入版本控制）
*.xlsm
*.xls
*.xlsx
*.xlsb
~$*.xlsm
~$*.xls
~$*.xlsx

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 虚拟环境
venv/
ENV/
env/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# 临时文件
.temp/
tmp/
temp/

# vba_src/ 为独立本地子仓库（无远程），仅用于 VBA 导出代码的临时差异对比
# 不入主仓库版本控制，不推送远程；任务结束后由 reset_vba_src.bat 清空重置
/vba_src/

# 日志文件
*.log

# 操作系统
.DS_Store
Thumbs.db
desktop.ini
result/